{
  "rules": {
    ".read": false,
    ".write": false,
    "events": {
      "sounds-of-revival-2026": {
        "submissions": {
          ".read": true,
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || auth.uid === 'REPLACE_WITH_YOUR_FIREBASE_ADMIN_UID')",
            ".validate": "newData.numChildren() <= 3",
            "$submissionId": {
              ".validate": "!newData.exists() || (newData.hasChildren(['name','createdAt']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 40)"
            }
          }
        }
      }
    }
  }
}
